#let f-npv(rate, values) = {
  let total = 0.0
  for (i, v) in values.enumerate() {
    total += v / calc.pow(1 + rate, i + 1)
  }
  total
}

#let f-irr(values, guess: 0.1) = {
  let r = guess
  for _ in range(100) {
    let f = 0.0
    let df = 0.0
    for (t, v) in values.enumerate() {
      f += v / calc.pow(1 + r, t)
      df -= t * v / calc.pow(1 + r, t + 1)
    }
    let step = f / df
    r -= step
    if calc.abs(step) < 1e-10 { break }
  }
  r
}

